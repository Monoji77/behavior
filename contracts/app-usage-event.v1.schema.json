
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-usage-streaming-analytics:contracts:app-usage-event:v1",
  "title": "App Usage Event v1",
  "description": "A single application open or close event emitted by a collector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "eventType",
    "app",
    "source",
    "deviceId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "enum": ["OPEN", "CLOSE"]
    },
    "app": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    }
  }
}